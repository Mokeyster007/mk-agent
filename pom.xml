<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>mk-agent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>mk-agent</name>
    <description>mk-agent</description>

    <properties>
        <java.version>21</java.version>

        <!--
            统一源码 / 资源编码为 UTF-8：
            中文 Windows 默认平台编码为 GBK，不显式声明时，
            源码中的中文常量（如工具失败标记、限流提示）会被编译成乱码。
        -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Spring AI 官方模块统一使用的版本 -->
        <spring-ai.version>1.0.0</spring-ai.version>

        <!-- Spring AI Alibaba / DashScope 组件版本 -->
        <spring-ai-alibaba.version>1.0.0.2</spring-ai-alibaba.version>

        <!--
            默认被排除的测试分组。
            live = 需要真实模型 / 真实搜索 / 真实数据库的测试：
            默认 mvn test 一律不跑，避免误消耗额度。
            pg   = 需要真实 PostgreSQL 的测试（M3 幂等/行锁语义验证）：
            默认构建必须显式排除，否则"默认全量测试不依赖 Docker"这条约定
            会在有人加了 @Tag("pg") 用例后悄悄失效。
            需要跑 live 测试时用 -Plive 把该值覆盖成 none（见 build/profiles）；
            只跑 pg 用例时用 -Dmkagent.test.excluded-groups=live -Dgroups=pg。
        -->
        <mkagent.test.excluded-groups>live,pg</mkagent.test.excluded-groups>

        <!--
            测试 JVM 参数（surefire argLine）。

            为什么要固化：可用物理内存偏紧时，默认参数的 forked VM 会直接崩溃
            （"Native memory allocation (malloc) failed ... for Chunk::new"、
            "The forked VM terminated without properly saying goodbye"），
            整轮测试中途中断，看起来像测试失败，其实是环境问题。

            - -Xmx512m：压小堆，给原生内存留空间；
            - -XX:+UseSerialGC：不预留 G1 的分区虚拟空间；
            - -XX:TieredStopAtLevel=1：只用 C1，不启用 C2。崩溃点是 C2 编译器的
              原生内存池（Chunk::new），测试场景不需要 C2 的极致优化。

            需要更大堆时用属性覆盖（不要用 -DargLine，见 docs/COST.md）：
              ./mvnw test -Dmkagent.test.jvm-args="-Xmx1g"
        -->
        <mkagent.test.jvm-args>-Xmx512m -XX:+UseSerialGC -XX:TieredStopAtLevel=1</mkagent.test.jvm-args>
    </properties>

    <dependencyManagement>
        <dependencies>

            <!--
                Spring AI 官方 BOM：
                统一管理 MCP、PgVector、RAG、Document Reader 等 Spring AI 模块版本。
            -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring AI Alibaba BOM：管理 DashScope 等 Alibaba 组件版本 -->
            <dependency>
                <groupId>com.alibaba.cloud.ai</groupId>
                <artifactId>spring-ai-alibaba-bom</artifactId>
                <version>${spring-ai-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- Spring Boot Web / Spring MVC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- DashScope 官方 SDK：用于你自行通过 SDK 调用模型 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>dashscope-sdk-java</artifactId>
            <version>2.19.1</version>
            <exclusions>
                <!--
                    dashscope-sdk-java 会把 slf4j-simple 作为 compile 依赖带进来。
                    classpath 上同时存在 logback 与 slf4j-simple 时，SLF4J 会在启动时打印
                    "Class path contains multiple SLF4J providers" 警告，
                    且绑定结果取决于加载顺序（可能变成 simple 输出、丢掉 logback 配置）。
                    这里排除掉，只保留 Spring Boot 默认的 logback。
                -->
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Spring AI Alibaba：自动配置 DashScope ChatModel、EmbeddingModel 等 -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-starter-dashscope</artifactId>
        </dependency>

        <!-- LangChain4j：用于你的 LangChain4j 调用示例 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-community-dashscope</artifactId>
            <version>1.0.0-beta2</version>
        </dependency>

        <!-- Hutool 工具库 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>5.8.37</version>
        </dependency>

        <!-- Knife4j / Swagger / OpenAPI -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
            <version>4.4.0</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring AI：Markdown 文档读取 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-markdown-document-reader</artifactId>
        </dependency>

        <!--
            Spring AI：OpenAI 兼容接口客户端。

            只引库、不引 starter：starter 会带上 OpenAiChatAutoConfiguration，
            它会自己造一个 ChatModel 并把容器里的 RetryTemplate 注进去，
            等于把"重试策略由谁决定"这件事又交回给框架。
            这里只用 OpenAiApi / OpenAiChatModel 两个类，手工构造、显式传入私有
            RetryTemplate（见 OpenAiCompatibleChatModelConfig）。
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-openai</artifactId>
        </dependency>

        <!-- Spring AI：RAG 向量库检索 Advisor -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-advisors-vector-store</artifactId>
        </dependency>

        <!-- Spring AI：PostgreSQL + pgvector 向量数据库 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>

        <!-- Spring AI：MCP Client，支持 stdio、SSE、Streamable HTTP -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <!-- 网页抓取与解析 -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.19.1</version>
        </dependency>

        <!-- JSON Schema：结构化输出 -->
        <dependency>
            <groupId>com.github.victools</groupId>
            <artifactId>jsonschema-generator</artifactId>
            <version>4.38.0</version>
        </dependency>

        <!-- Kryo：会话记忆序列化等 -->
        <dependency>
            <groupId>com.esotericsoftware</groupId>
            <artifactId>kryo</artifactId>
            <version>5.6.2</version>
        </dependency>

        <!-- iText：PDF 生成 -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itext-core</artifactId>
            <version>9.1.0</version>
            <type>pom</type>
        </dependency>

        <!-- MyBatis-Plus：AgentRun 任务持久化（Spring Boot 3 专用 starter） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.7</version>
        </dependency>

        <!-- Actuator：健康检查（DB / 模型配置轻量级探针） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- PostgreSQL 驱动：agent_run 表复用 pgvector 已有的 PostgreSQL 数据源 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- H2：测试用内存数据库（PostgreSQL 兼容模式），测试不依赖外部数据库 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 测试时使用中文字体 -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>font-asian</artifactId>
            <version>9.1.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <!--
            ===========================================================
            资源过滤：显式关闭（打包安全的关键一条）
            ===========================================================
            spring-boot-starter-parent 默认对 src/main/resources 下的
            application*.yml / *.yaml / *.properties 打开 filtering
            （分隔符是 @...@，不是 ${...}）。

            这条默认规则本身是"方便"，但对本项目是风险：
            只要有人写出 @MKAGENT_MODEL_API_KEY@ 这类占位符，
            构建时就会把当前 shell / CI 里的密钥**展开并写回** target/classes，
            再原样打进 jar——密钥从"运行时注入"退回"随包分发"，
            而且源码里看不出任何痕迹（源码只有占位符，jar 里是明文）。

            所以这里覆盖父 POM 的 resources 定义并关闭 filtering：
            配置文件一律按源码原样复制，${ENV:default} 只在运行时由 Spring 解析。
            本项目资源目录中没有任何 @...@ 构建期占位符，
            关闭过滤不影响现有功能（已用打包产物核对，见 docs/SECURITY.md 第 7 节）。
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        @Tag("live") 的测试默认被排除。
                        这类测试会调用真实模型 / 搜索 API / 真实数据库，属于付费且有外部依赖的测试，
                        不能因为"顺手跑了全量测试"就默默花钱。
                    -->
                    <excludedGroups>${mkagent.test.excluded-groups}</excludedGroups>

                    <!--
                        堆参数走属性（mkagent.test.jvm-args），便于按机器覆盖；
                        用属性而不是直接写死，避免每次在命令行手敲一长串。
                    -->
                    <argLine>${mkagent.test.jvm-args}</argLine>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <profile>
            <!--
                显式开启 live 测试：
                  mvn -Plive -Dtest=AgentEvalRunnerTest -Dmkagent.eval.enabled=true test
                excludedGroups 用哨兵值 none（不存在同名分组），
                等价于"不排除任何分组"，同时避免空字符串被 surefire 当成非法值。
            -->
            <id>live</id>
            <properties>
                <mkagent.test.excluded-groups>none</mkagent.test.excluded-groups>
            </properties>
        </profile>

        <profile>
            <!--
                本地演示 / 私有演示：不依赖 PostgreSQL 的完整闭环。

                  mvnw -Pdemo spring-boot:run -Dspring-boot.run.profiles=demo

                H2 只在 demo profile 下进入运行时 classpath：
                默认构建（以及打包出的 jar）仍然只带 PostgreSQL 驱动，
                不会因为"要演示"就让生产产物多背一个数据库引擎。
            -->
            <id>demo</id>
            <dependencies>
                <dependency>
                    <groupId>com.h2database</groupId>
                    <artifactId>h2</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

</project>